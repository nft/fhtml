header sticky top-0 z-50 border-b border-slate-200 bg-white/80 backdrop-blur-md dark:border-slate-800 dark:bg-slate-950/80
  nav(aria-label="Main navigation") mx-auto flex max-w-7xl items-center justify-between px-6 py-4 lg:px-8
    . flex items-center gap-x-10
      a(href=/) flex items-center gap-x-2
        <svg class="h-7 w-7 text-sky-500" viewBox="0 0 28 28" fill="none" aria-hidden="true">
                    <path d="M14 2a12 12 0 100 24 12 12 0 000-24z" stroke="currentColor" stroke-width="2"></path>
                    <path d="M8 14c2-4 4-6 6-6s4 2 6 6c-2 4-4 6-6 6s-4-2-6-6z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
                  </svg>
        span text-lg font-semibold tracking-tight text-slate-900 dark:text-white "Orbitdesk"
      . hidden items-center gap-x-8 lg:flex
        a(href=/product) text-sm font-medium text-slate-700 transition hover:text-slate-900 dark:text-slate-300 dark:hover:text-white "Product"
        a(href=/solutions) text-sm font-medium text-slate-700 transition hover:text-slate-900 dark:text-slate-300 dark:hover:text-white "Solutions"
        a(href=/pricing) text-sm font-medium text-slate-700 transition hover:text-slate-900 dark:text-slate-300 dark:hover:text-white "Pricing"
        a(href=/customers) text-sm font-medium text-slate-700 transition hover:text-slate-900 dark:text-slate-300 dark:hover:text-white "Customers"
        a(href=/docs) text-sm font-medium text-slate-700 transition hover:text-slate-900 dark:text-slate-300 dark:hover:text-white "Docs"
    . hidden items-center gap-x-4 lg:flex
      a(href=/login) text-sm font-medium text-slate-700 transition hover:text-slate-900 dark:text-slate-300 dark:hover:text-white "Log in"
      a(href=/signup) rounded-md bg-sky-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-sky-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600 "Start free"
    button(type=button data-state=closed aria-expanded=false aria-controls=mobile-menu) group inline-flex items-center justify-center rounded-md p-2 text-slate-700 transition hover:bg-slate-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600 lg:hidden dark:text-slate-300 dark:hover:bg-slate-800
      span sr-only "Open main menu"
      <svg class="h-6 w-6 group-data-[state=open]:hidden" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
              </svg>
      <svg class="hidden h-6 w-6 group-data-[state=open]:block" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
              </svg>
  .(data-state=closed) #mobile-menu hidden border-t border-slate-200 px-6 pt-4 pb-6 data-[state=open]:block lg:hidden dark:border-slate-800
    . space-y-1
      a(href=/product) block rounded-md px-3 py-2 text-base font-medium text-slate-900 hover:bg-slate-50 dark:text-white dark:hover:bg-slate-800 "Product"
      a(href=/solutions) block rounded-md px-3 py-2 text-base font-medium text-slate-900 hover:bg-slate-50 dark:text-white dark:hover:bg-slate-800 "Solutions"
      a(href=/pricing) block rounded-md px-3 py-2 text-base font-medium text-slate-900 hover:bg-slate-50 dark:text-white dark:hover:bg-slate-800 "Pricing"
      a(href=/customers) block rounded-md px-3 py-2 text-base font-medium text-slate-900 hover:bg-slate-50 dark:text-white dark:hover:bg-slate-800 "Customers"
      a(href=/docs) block rounded-md px-3 py-2 text-base font-medium text-slate-900 hover:bg-slate-50 dark:text-white dark:hover:bg-slate-800 "Docs"
    . mt-4 space-y-2 border-t border-slate-200 pt-4 dark:border-slate-800
      a(href=/login) block rounded-md px-3 py-2 text-base font-medium text-slate-900 hover:bg-slate-50 dark:text-white dark:hover:bg-slate-800 "Log in"
      a(href=/signup) block rounded-md bg-sky-600 px-3 py-2 text-center text-base font-semibold text-white hover:bg-sky-500 "Start free"
