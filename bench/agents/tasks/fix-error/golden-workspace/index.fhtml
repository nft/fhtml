section bg-slate-50 py-24 sm:py-32 > . mx-auto max-w-[76rem] px-6 lg:px-8
  . mx-auto max-w-3xl text-center
    h2 text-base font-semibold leading-7 text-indigo-600 "Pricing"
    p mt-2 text-4xl font-semibold tracking-tight text-slate-900 sm:text-5xl "Plans that scale with your call volume"
    p mt-6 text-lg leading-8 text-slate-600
      | Every plan includes unlimited agents, call recording, and our 99.99% uptime SLA. Switch or cancel any time.
  . mx-auto mt-16 grid max-w-md grid-cols-1 gap-8 lg:max-w-none lg:grid-cols-3
    . flex flex-col rounded-3xl bg-white p-8 ring-1 ring-slate-200 xl:p-10
      h3 text-lg font-semibold leading-8 text-slate-900 "Starter"
      p mt-2 text-sm leading-6 text-slate-600 "For small teams answering their first support lines."
      p mt-6 flex items-baseline gap-x-1
        span text-4xl font-semibold tracking-tight text-slate-900 "$29"
        span text-sm font-semibold leading-6 text-slate-600 "/agent/mo"
      a(href=/signup?plan=starter) mt-6 block rounded-md px-3 py-2 text-center text-sm font-semibold leading-6 text-indigo-600 ring-1 ring-inset ring-indigo-200 hover:ring-indigo-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 "Start free trial"
      ul(role=list) mt-8 space-y-3 text-sm leading-6 text-slate-600
        li flex gap-x-3
          <svg class="h-6 w-5 flex-none text-indigo-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 111.4-1.4L8 12.6l7.3-7.3a1 1 0 011.4 0z" clip-rule="evenodd"></path></svg>
          |  2,000 minutes of inbound calling
        li flex gap-x-3
          <svg class="h-6 w-5 flex-none text-indigo-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 111.4-1.4L8 12.6l7.3-7.3a1 1 0 011.4 0z" clip-rule="evenodd"></path></svg>
          |  Shared inbox and voicemail transcripts
        li flex gap-x-3
          <svg class="h-6 w-5 flex-none text-indigo-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 111.4-1.4L8 12.6l7.3-7.3a1 1 0 011.4 0z" clip-rule="evenodd"></path></svg>
          |  Email support within one business day
    . relative flex flex-col rounded-3xl bg-slate-900 p-8 ring-2 ring-indigo-500 xl:p-10
      p absolute -top-4 left-1/2 -translate-x-1/2 rounded-full bg-indigo-500 px-4 py-1 text-xs font-semibold text-white "Most popular"
      h3 text-lg font-semibold leading-8 text-white "Growth"
      p mt-2 text-sm leading-6 text-slate-300 "For scaling support orgs that live in their queue."
      p mt-6 flex items-baseline gap-x-1
        span text-4xl font-semibold tracking-tight text-white "$79"
        span text-sm font-semibold leading-6 text-slate-300 "/agent/mo"
      a(href=/signup?plan=growth) mt-6 block rounded-md bg-indigo-500 px-3 py-2 text-center text-sm font-semibold leading-6 text-white shadow-sm hover:bg-indigo-400 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500 "Start free trial"
      ul(role=list) mt-8 space-y-3 text-sm leading-6 text-slate-300
        li flex gap-x-3
          <svg class="h-6 w-5 flex-none text-indigo-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 111.4-1.4L8 12.6l7.3-7.3a1 1 0 011.4 0z" clip-rule="evenodd"></path></svg>
          |  Unlimited inbound and outbound minutes
        li flex gap-x-3
          <svg class="h-6 w-5 flex-none text-indigo-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 111.4-1.4L8 12.6l7.3-7.3a1 1 0 011.4 0z" clip-rule="evenodd"></path></svg>
          |  AI call summaries and sentiment scoring
        li flex gap-x-3
          <svg class="h-6 w-5 flex-none text-indigo-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 111.4-1.4L8 12.6l7.3-7.3a1 1 0 011.4 0z" clip-rule="evenodd"></path></svg>
          |  Salesforce, HubSpot, and Zendesk sync
        li flex gap-x-3
          <svg class="h-6 w-5 flex-none text-indigo-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 111.4-1.4L8 12.6l7.3-7.3a1 1 0 011.4 0z" clip-rule="evenodd"></path></svg>
          |  Priority support with 2-hour response
    . flex flex-col rounded-3xl bg-white p-8 ring-1 ring-slate-200 xl:p-10
      h3 text-lg font-semibold leading-8 text-slate-900 "Enterprise"
      p mt-2 text-sm leading-6 text-slate-600 "For regulated teams with custom routing and residency needs."
      p mt-6 flex items-baseline gap-x-1 > span text-4xl font-semibold tracking-tight text-slate-900 "Custom"
      a(href=/contact-sales) mt-6 block rounded-md px-3 py-2 text-center text-sm font-semibold leading-6 text-indigo-600 ring-1 ring-inset ring-indigo-200 hover:ring-indigo-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 "Talk to sales"
      ul(role=list) mt-8 space-y-3 text-sm leading-6 text-slate-600
        li flex gap-x-3
          <svg class="h-6 w-5 flex-none text-indigo-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 111.4-1.4L8 12.6l7.3-7.3a1 1 0 011.4 0z" clip-rule="evenodd"></path></svg>
          |  SSO, SCIM provisioning, and audit logs
        li flex gap-x-3
          <svg class="h-6 w-5 flex-none text-indigo-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 111.4-1.4L8 12.6l7.3-7.3a1 1 0 011.4 0z" clip-rule="evenodd"></path></svg>
          |  EU and US data residency options
        li flex gap-x-3
          <svg class="h-6 w-5 flex-none text-indigo-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 111.4-1.4L8 12.6l7.3-7.3a1 1 0 011.4 0z" clip-rule="evenodd"></path></svg>
          |  Dedicated success engineer and onboarding
