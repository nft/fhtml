doctype
html(lang=en) scroll-smooth
  head
    meta(charset=utf-8)
    meta(name=viewport content="width=device-width, initial-scale=1")
    title "Acme — Ship faster"
    <style>
          :root { --brand: #4f46e5; }
          .prose code { background: #f4f4f5; padding: 0 .25rem; }
        </style>
  body bg-white text-zinc-900 antialiased dark:bg-zinc-950 dark:text-zinc-100
    //! Site header
    header sticky top-0 z-40 border-b border-zinc-200 bg-white/80 backdrop-blur dark:border-zinc-800 dark:bg-zinc-950/80 > nav mx-auto flex max-w-6xl items-center justify-between px-4 py-3
      a(href=/) text-lg font-bold tracking-tight "Acme"
      ul flex items-center gap-6 text-sm font-medium
        li > a(href=/features) hover:text-indigo-600 "Features"
        li > a(href=/pricing) hover:text-indigo-600 "Pricing"
        li > a(href=/docs) hover:text-indigo-600 "Docs"
    main
      section mx-auto max-w-6xl px-4 py-24 text-center
        h1 text-5xl font-bold tracking-tight
          | Ship
          |
          em text-indigo-600 not-italic "10×"
          |  faster
        p mx-auto mt-6 max-w-2xl text-lg text-zinc-500
          | Acme compiles your ideas straight to production. No config, no yak-shaving, no regrets.
        form(action=/signup method=post) mx-auto mt-10 flex max-w-md gap-2
          label(for=email) sr-only "Email"
          input(name=email type=email required placeholder=you@example.com) #email w-full rounded-lg border border-zinc-300 px-3 py-2 text-sm focus:outline-2 focus:outline-indigo-600
          button(type=submit) rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500 "Start free"
      section mx-auto max-w-6xl px-4 py-16
        h2 text-2xl font-semibold "Install"
        <pre class="mt-4 overflow-x-auto rounded-lg bg-zinc-900 p-4 text-sm text-zinc-100"><code>$ cargo install acme&#10;$ acme init my-app&#10;    --template starter</code></pre>
        table mt-8 w-full text-left text-sm
          thead border-b border-zinc-200 text-zinc-500 > tr
            th py-2 "Plan"
            th py-2 "Projects"
            th py-2 "Price"
          tbody divide-y divide-zinc-100
            tr
              td py-2 "Free"
              td "3"
              td "$0"
            tr
              td py-2 "Pro"
              td "Unlimited"
              td "$29"
    footer border-t border-zinc-200 py-10 text-center text-sm text-zinc-500 dark:border-zinc-800 > p
      | © 2026 Acme Inc. ·
      |
      a(href=/legal) underline "Legal"
    <script>
          document.querySelectorAll('a[href^="/"]').forEach(function (a) {
            a.addEventListener('click', function () {
              // analytics beacon; failures are fine
              navigator.sendBeacon('/t', a.href);
            });
          });
        </script>
